# Copy to .env and change every value marked CHANGE-ME. Never commit .env.
# Used by: docker compose (root .env) AND the backend when run locally (Spring imports ../.env).

# --- MySQL ---
MYSQL_DATABASE=smartpay
MYSQL_ROOT_PASSWORD=Bhavesh@123
DB_USERNAME=smartpay
DB_PASSWORD=SmartPay@123


# --- Security ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=0123456789012345678901234567890123456789012345678901234567890123
JWT_EXPIRATION_MINUTES=60

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
# true loads demo users + sample transactions (see README for credentials). Turn off for anything real.
APP_SEED_ENABLED=true
APP_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Risk rules (all optional; defaults shown) ---
PAYMENT_MAX_TRANSACTION_LIMIT=50000
PAYMENT_DAILY_LIMIT=100000
PAYMENT_VELOCITY_LIMIT=5
PAYMENT_VELOCITY_WINDOW_MINUTES=10

# --- Kafka (only needed when running the backend outside Docker) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_ENABLED=true
