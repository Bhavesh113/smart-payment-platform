# Copy this file to .env and replace all CHANGE-ME values.
# Never commit your actual .env file.

# --- MySQL ---
MYSQL_DATABASE=smartpay
MYSQL_ROOT_PASSWORD=CHANGE-ME
DB_USERNAME=smartpay
DB_PASSWORD=CHANGE-ME

# --- Security ---
# Generate a unique, strong secret for your environment.
JWT_SECRET=CHANGE-ME
JWT_EXPIRATION_MINUTES=60

# --- Application ---
# Use dev locally; use prod for deployment.
SPRING_PROFILES_ACTIVE=dev
APP_SEED_ENABLED=true
APP_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Risk rules ---
PAYMENT_MAX_TRANSACTION_LIMIT=50000
PAYMENT_DAILY_LIMIT=100000
PAYMENT_VELOCITY_LIMIT=5
PAYMENT_VELOCITY_WINDOW_MINUTES=10

# --- Kafka (only needed when running the backend outside Docker) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_ENABLED=true